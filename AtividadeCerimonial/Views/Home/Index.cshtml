@{
    ViewData["Title"] = "Enlace";
}

<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Enlace - Cerimônias</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AtividadeCerimonial.site.css" asp-append-version="true" />
</head>

<body>


    <!-- HERO -->
    <section class="hero" id="sobre">

        <div class="hero-text">

            <h1>
                Cerimônias que<br />
                contam a sua história
            </h1>

            <p>
                Condução de cerimônias de casamento com
                acolhimento, elegância e atenção a cada detalhe
            </p>

            <a class="link-wine" asp-controller="Cerimonias" asp-action="Index">
                Cadastrar Cerimônia
            </a>

            
        </div>


        <div class="imagem-aliancas">

            <img src="https://novanoiva.com.br/wp-content/uploads/2025/05/Inspiracoes-de-frases-para-o-convite-de-casamento.png"
                 alt="Alianças de casamento">

        </div>


    </section>

    <!-- =========================
        SERVIÇOS
========================= -->

    <section class="servicos">

        <div class="container">

            <div class="titulo-secao">
                <span>O que fazemos</span>
                <h2>Nossos Serviços</h2>
                <p>
                    Cuidamos de cada detalhe para tornar sua cerimônia
                    especial e inesquecível.
                </p>
            </div>


            <div class="servicos-grid">

                <!-- SERVIÇO 1 -->
                <div class="servico-card">

                    <div class="icone-servico">
                        ♡
                    </div>

                    <h3>Cerimônia Civil</h3>

                    <p>
                        Roteiro personalizado para o casal
                    </p>

                </div>


                <!-- SERVIÇO 2 -->
                <div class="servico-card">

                    <div class="icone-servico">
                        ♡
                    </div>

                    <h3>Mestre de Cerimônias</h3>

                    <p>
                        Condução completa do grande dia
                    </p>

                </div>


                <!-- SERVIÇO 3 -->
                <div class="servico-card">

                    <div class="icone-servico">
                        ♡
                    </div>

                    <h3>Assembleia de Roteiro</h3>

                    <p>
                        Ensaio e apoio no dia da cerimonia
                    </p>

                </div>

            </div>

        </div>

    </section>



    <!-- =========================
    SOBRE
========================= -->

    <section class="sobre" id="sobre">

        <div class="container">

            <div class="sobre-grid">

                <!-- IMAGEM -->
                <div class="sobre-imagem">

                    <img class="img-fluid rounded-4 shadow hero-image"
                         src="https://cdn0.casamentos.com.br/article-vendor/8379/3_2/1920/jpg/mari-leo-previas-49_13_178379-166013221645741.webp"
                         alt="Casal em cerimônia de casamento" />

                </div>


                <!-- TEXTO -->
                <div class="sobre-texto">

                    <span class="pequeno-titulo">
                        Sobre nós
                    </span>

                    <h2>
                        Sobre a Elance
                    </h2>

                    <p>
                        Na Elance Cerimonial, transformamos momentos únicos em memórias inesquecíveis. Nosso trabalho
                        vai muito além da condução de uma cerimônia:
                        cuidamos de cada detalhe para que sua celebração reflita, de forma autêntica, a história e a
                        essência de quem você é.
                    </p>

                    <a class="link-wine" asp-controller="Cerimonias" asp-action="Index">
                        Cadastrar Cerimônia
                    </a>

                </div>

            </div>

        </div>

    </section>

    <!-- CERIMONIALISTA - SERIVICOS-->
    <section class="cerimonialista" id="servicos">

        <div class="container">

            <div class="cerimonialista-conteudo">

                <!-- FOTO -->
                <div class="cerimonialista-foto">

                    <img src="https://img.magnific.com/fotos-gratis/planejador-de-casamento-feminino-trabalhando-em-uma-cerimonia_23-2150167218.jpg?semt=ais_hybrid&w=740&q=80"
                         alt="Casal em cerimônia de casamento" />

                </div>

                <!-- TEXTO -->
                <div class="cerimonialista-texto">

                    <span>Conheça nossos Serviços</span>

                    <h2>
                        Cuidando de cada detalhe
                        do seu grande dia.
                    </h2>

                    <p>
                        A Elance Cerimonial nasceu da paixão por transformar cerimônias em momentos únicos e
                        inesquecíveis.
                        Com sensibilidade, profissionalismo e atenção a cada detalhe, conduzimos seu grande dia com a
                        emoção e a elegância que ele merece.
                    </p>

                    <a class="link-wine" asp-controller="Cerimonias" asp-action="Index">
                        Cadastrar Cerimônia
                    </a>

                </div>

            </div>

        </div>

    </section>

    <!-- =========================
    DEPOIMENTOS
========================= -->

    <section class="depoimentos" id="depoimentos">

        <div class="container">

            <div class="titulo-secao">

                <span>Histórias reais</span>

                <h2>
                    O que nossos clientes dizem
                </h2>

                <p>
                    Cada cerimônia é única. E cada história merece
                    ser contada com carinho.
                </p>

            </div>


            <div class="depoimentos-grid">


                <!-- DEPOIMENTO 1 -->
                <div class="depoimento">

                    <img src="https://i.pinimg.com/736x/3f/1a/29/3f1a29fe0705826e62f6eb57ce14c17f.jpg"
                         alt="Casal em cerimônia de casamento" />

                    <h3>
                        Gabriel e Gabriela
                    </h3>

                    <div class="estrelas">
                        ★★★★★
                    </div>

                    <p>
                        "Uma equipe excelente, prestativa e
                        muito comprometida. Tornaram nosso
                        dia ainda mais especial."
                    </p>

                </div>


                <!-- DEPOIMENTO 2 -->
                <div class="depoimento">

                    <img src="https://inesquecivelcasamento.com.br/wp-content/uploads/2024/05/casamento-classico-gabriela-e-marlon-foto-Fotos-Adalberto-Rodrigues-3.jpg"
                         alt="Casal em cerimônia de casamento" />

                    <h3>
                        Daniel e Daniela
                    </h3>

                    <div class="estrelas">
                        ★★★★★
                    </div>

                    <p>
                        "Tudo foi organizado com muito carinho.
                        Pudemos aproveitar cada momento
                        sem preocupações."
                    </p>

                </div>


                <!-- DEPOIMENTO 3 -->
                <div class="depoimento">

                    <img src="https://cdn.alboompro.com/5e662dbcc527ae00015f2530_6883c3fabe92730001ad2816/large/fotografia-de-casamento-637.jpeg?v=1"
                         alt="Casal em cerimônia de casamento" />

                
                    <h3>
                        Fernando e Fernanda
                    </h3>

                    <div class="estrelas">
                        ★★★★★
                    </div>

                    <p>
                        "A cerimônia ficou exatamente como
                        imaginávamos. Foi emocionante
                        do começo ao fim."
                    </p>

                </div>

            </div>

        </div>

    </section>



    <!-- =========================
    ORÇAMENTO
========================= -->

    <section class="orcamento" id="orcamento">

        <div class="container">

            <h2>
                Vamos tornar esse momento inesquecível?
            </h2>

            <p>
                Entre em contato com a Elance Cerimonial
                e cadastre seu casamento.
            </p>

            <a class="link-wine" asp-controller="Cerimonias" asp-action="Index">
                Cadastrar Cerimônia
            </a>

        </div>

    </section>
</section>
</body>

</html>